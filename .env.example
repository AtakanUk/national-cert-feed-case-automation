# National CERT notification API
NATIONAL_CERT_BASE_URL=https://cert-api.example.com/v1
NATIONAL_CERT_API_TOKEN=your-api-token
NATIONAL_CERT_VERIFY_SSL=true
HTTP_PROXY_URL=
HTTPS_PROXY_URL=
# Link put into the incident; {id} is replaced with the notification ID
CERT_PORTAL_CASE_URL=https://cert-portal.example.com/#/notification/{id}

# Collector
LOOKBACK_SECONDS=3600
DEDUP_DAYS=30

# IBM QRadar SOAR
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Org
SOAR_API_KEY_ID=your-api-key-id
SOAR_API_KEY_SECRET=your-api-key-secret
SOAR_CAFILE=
# Comma-separated incident type IDs or names
SOAR_INCIDENT_TYPES=
